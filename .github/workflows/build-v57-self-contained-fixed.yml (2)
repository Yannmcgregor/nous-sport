name: Build Nous Sport V57

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Prepare V57 project
        shell: bash
        run: |
          set -euo pipefail
          rm -rf v57-extracted
          mkdir -p v57-extracted

          ZIP="$(find . -type f -iname '*V57*.zip' -print -quit || true)"
          if [ -n "$ZIP" ]; then
            echo "ZIP V57 trouvé dans le dépôt: $ZIP"
          else
            echo "ZIP V57 absent du dépôt: utilisation de V57 intégré au workflow."
            cat > /tmp/v57.b64 <<'V57BASE64'

V57BASE64
            base64 -d /tmp/v57.b64 > /tmp/V57.zip
            ZIP=/tmp/V57.zip
          fi

          unzip -q -o "$ZIP" -d v57-extracted
          ANDROID_DIR="$(find v57-extracted -type f -path '*/android/app/build.gradle' -print -quit | sed 's#/app/build.gradle##')"
          test -n "$ANDROID_DIR"
          test -f "$ANDROID_DIR/app/build.gradle"
          test -f "$ANDROID_DIR/app/src/main/java/com/noussport/app/MainActivity.kt"

          echo "ANDROID_DIR=$ANDROID_DIR" >> "$GITHUB_ENV"
          echo "Projet Android sélectionné: $ANDROID_DIR"

      - name: Verify V57 diagnostic
        shell: bash
        run: |
          set -euo pipefail
          KT="$ANDROID_DIR/app/src/main/java/com/noussport/app/MainActivity.kt"
          GRADLE="$ANDROID_DIR/app/build.gradle"
          HTML="$ANDROID_DIR/app/src/main/assets/index.html"

          grep -Fq 'NOUS SPORT V57' "$KT"
          grep -Fq 'DataOrigin("com.sec.android.app.shealth")' "$KT"
          grep -Fq 'ReadRecordsRequest' "$KT"
          grep -Fq 'aggregateGroupByPeriod' "$KT"
          grep -Fq 'health_diagnostic' "$KT"
          grep -Fq 'versionCode 97' "$GRADLE"
          grep -Fq "versionName '0.9.20'" "$GRADLE"
          grep -Fq 'health_diagnostic' "$HTML"

          echo "V57 vérifiée: diagnostic agrégé/période/Samsung/brut activé."

      - name: Build APK
        shell: bash
        run: |
          set -euo pipefail
          cd "$ANDROID_DIR"
          if [ ! -f gradlew ]; then
            gradle wrapper --gradle-version 8.11.1
          fi
          chmod +x gradlew
          ./gradlew clean assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Nous-Sport-V57-APK
          path: '**/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
