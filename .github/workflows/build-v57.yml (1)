name: Build Nous Sport V57

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Prepare V57
        shell: bash
        run: |
          set -euo pipefail

          test -f V57.zip

          rm -rf v57-extracted
          mkdir -p v57-extracted
          unzip -q -o V57.zip -d v57-extracted

          ANDROID_DIR="$(find v57-extracted -type f -path '*/app/build.gradle' -print -quit | xargs -r dirname | xargs -r dirname)"
          test -n "$ANDROID_DIR"
          test -f "$ANDROID_DIR/settings.gradle"
          test -f "$ANDROID_DIR/app/build.gradle"
          test -f "$ANDROID_DIR/app/src/main/java/com/noussport/app/MainActivity.kt"

          echo "ANDROID_DIR=$ANDROID_DIR" >> "$GITHUB_ENV"
          echo "Projet V57 trouvé dans: $ANDROID_DIR"

      - name: Verify V57
        shell: bash
        run: |
          set -euo pipefail

          KT="$ANDROID_DIR/app/src/main/java/com/noussport/app/MainActivity.kt"
          GRADLE="$ANDROID_DIR/app/build.gradle"

          grep -Fq 'NOUS SPORT V57' "$KT"
          grep -Fq 'import androidx.health.connect.client.records.metadata.DataOrigin' "$KT"
          grep -Fq 'ReadRecordsRequest' "$KT"
          grep -Fq 'AggregateGroupByPeriodRequest' "$KT"
          grep -Fq "versionCode 97" "$GRADLE"
          grep -Fq "versionName '0.9.20'" "$GRADLE"

          echo "V57 vérifiée."

      - name: Build APK
        shell: bash
        run: |
          set -euo pipefail
          cd "$ANDROID_DIR"

          gradle clean assembleDebug --no-daemon --stacktrace

          test -f app/build/outputs/apk/debug/app-debug.apk
          cp app/build/outputs/apk/debug/app-debug.apk "$GITHUB_WORKSPACE/V57.apk"

      - name: Upload V57 APK
        uses: actions/upload-artifact@v4
        with:
          name: V57-APK
          path: V57.apk
          if-no-files-found: error
