name: Build Nous Sport V57

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle 8.11.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Prepare V57 project
        shell: bash
        run: |
          set -euo pipefail

          test -f V57.zip
          rm -rf v57-extracted
          mkdir -p v57-extracted

          unzip -q -o V57.zip -d v57-extracted

          test -f v57-extracted/android/settings.gradle
          test -f v57-extracted/android/build.gradle
          test -f v57-extracted/android/app/build.gradle
          test -f v57-extracted/android/app/src/main/AndroidManifest.xml
          test -f v57-extracted/android/app/src/main/java/com/noussport/app/MainActivity.kt
          test -f v57-extracted/android/app/src/main/assets/index.html

          echo "ANDROID_DIR=$GITHUB_WORKSPACE/v57-extracted/android" >> "$GITHUB_ENV"
          echo "V57 ZIP validé et projet Android trouvé."

      - name: Build V57 APK
        shell: bash
        run: |
          set -euo pipefail
          cd "$ANDROID_DIR"

          gradle wrapper --gradle-version 8.11.1 --distribution-type bin
          chmod +x gradlew
          ./gradlew clean assembleDebug --no-daemon --stacktrace

      - name: Rename APK to V57.apk
        shell: bash
        run: |
          set -euo pipefail
          APK="$(find "$ANDROID_DIR" -type f -path '*/build/outputs/apk/debug/*.apk' -print -quit)"
          test -n "$APK"
          cp "$APK" "$GITHUB_WORKSPACE/V57.apk"
          ls -lh "$GITHUB_WORKSPACE/V57.apk"

      - name: Upload V57 APK
        uses: actions/upload-artifact@v4
        with:
          name: V57
          path: V57.apk
          if-no-files-found: error
